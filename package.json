{
  "name": "wave",
  "displayName": "Wave",
  "description": "Wave Language Support",
  "repository": "https://github.com/wavefnd/wave-vscode",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "publisher": "wave-language",
  "license": "MPL-2.0",
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:wave"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm test",
    "compile": "tsc -p ./",
    "test": "npm run compile && node scripts/verify.mjs",
    "watch": "tsc --watch -p ./"
  },
  "contributes": {
    "languages": [
      {
        "id": "wave",
        "aliases": [
          "Wave",
          "wave"
        ],
        "extensions": [
          ".wave"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "commands": [
      {
        "command": "wave.runCurrentFile",
        "title": "Run Wave Current File"
      },
      {
        "command": "wave.restartLanguageServer",
        "title": "Wave: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Wave",
      "properties": {
        "wave.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the wave-agape language server. Empty uses a bundled binary or wave-agape from PATH."
        },
        "wave.languageServer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to the Wave language server."
        },
        "wave.languageServer.useWsl": {
          "type": "boolean",
          "default": false,
          "description": "Launch the Wave language server through WSL on Windows."
        },
        "wave.imports.standardLibraryPath": {
          "type": "string",
          "default": "",
          "description": "Wave standard-library directory. Empty uses WAVE_STDLIB_PATH or ~/.wave/lib/wave/std."
        },
        "wave.imports.dependencyRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories containing external Wave packages, equivalent to wavec --dep-root."
        },
        "wave.imports.dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "External Wave package names mapped to directories, equivalent to wavec --dep name=path."
        },
        "wave.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to the native wavec compiler. Empty uses wavec from PATH."
        },
        "wave.compiler.useWsl": {
          "type": "boolean",
          "default": false,
          "description": "Launch wavec through WSL on Windows instead of using the native compiler."
        }
      }
    },
    "grammars": [
      {
        "language": "wave",
        "scopeName": "source.wave",
        "path": "./syntaxes/wave.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.102.0",
    "typescript": "^7.0.2"
  }
}
