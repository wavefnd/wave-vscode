{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wave",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#main_function" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.wave", "match": "//.*$" },
        {
          "name": "comment.block.wave",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wave",
          "match": "\\b(as|asm|break|class|clobber|const|continue|deref|else|enum|export|extern|false|for|fun|if|import|in|input|is|let|match|module|mut|null|out|print|println|proto|return|static|struct|true|type|var|while|xnand)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.wave",
          "match": "\\b(i8|i16|i32|i64|i128|i256|i512|i1024|isz|u8|u16|u32|u64|u128|u256|u512|u1024|usz|f32|f64|bool|byte|char|str|void)\\b"
        },
        {
          "name": "storage.type.container.wave",
          "match": "\\b(ptr|array)\\b"
        },
        {
          "name": "punctuation.definition.typeparameters.begin.wave",
          "match": "<"
        },
        {
          "name": "punctuation.definition.typeparameters.end.wave",
          "match": ">"
        }
      ]
    },
    "main_function": {
      "patterns": [
        {
          "name": "entity.name.function.main.wave",
          "match": "\\bfun\\s+main\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.wave",
          "match": "\\bfun\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.wave" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.wave",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.wave",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.wave",
          "match": "\\\\."
        },
        {
          "name": "variable.parameter.format.wave",
          "match": "\\{[^}]*\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.wave",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.wave",
          "match": "!=|==|<=|>=|<|>|\\+|\\-|\\*|\\/|%|\\+=|\\-=|\\*=|\\/=|&&|\\|\\||!|\\?|:"
        }
      ]
    }
  },
  "scopeName": "source.wave"
}
